{
  "name": "sinaicore-scrollytelling",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "models": "node scripts/build-models.mjs",
    "textures": "node scripts/build-textures.mjs",
    "assets": "npm run models && npm run textures",
    "artwork": "node scripts/build-artwork.mjs",
    "viewer": "vite --config viewer/vite.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "postprocessing": "^6.37.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.1",
    "draco3dgltf": "^1.5.9",
    "ktx2-encoder": "^0.6.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
